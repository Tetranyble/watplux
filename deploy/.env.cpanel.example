NODE_ENV=production
DEPLOYMENT_ENV=production
LOG_LEVEL=info
APP_VERSION=0.1.0
GIT_SHA=replace-with-release-sha

# Use a cPanel-managed MySQL 8 database only when the host provides reliable
# backups/PITR; otherwise use an external managed MySQL service.
DATABASE_URL="mysql://CPANEL_DB_USER:STRONG_PASSWORD@localhost:3306/CPANEL_DB_NAME"

BETTER_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://your-domain.example
APP_BASE_URL=https://your-domain.example
SESSION_TTL_DAYS=30

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=notifications@your-domain.example
MAIL_PASSWORD=replace-me
MAIL_FROM_ADDRESS=notifications@your-domain.example
MAIL_FROM_NAME=Watplux

# Optional Termii SMS acknowledgement for service requests.
# TERMII_BASE_URL=https://your-region.termii.com
# TERMII_API_KEY=replace-me
# TERMII_SENDER_ID=Watplux
# TERMII_CHANNEL=dnd
# TERMII_DEFAULT_COUNTRY_CODE=234

# Use the one client-IP header that the cPanel proxy overwrites. If Cloudflare
# proxies the site, prefer cf-connecting-ip after confirming it cannot be
# supplied directly by clients.
TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

PAYSTACK_SECRET_KEY=sk_live_replace_me
GUEST_ORDER_TOKEN_SECRET=replace-with-random-secret-at-least-32-characters
INTERNAL_WORKER_SECRET=replace-with-random-secret-at-least-32-characters
WEBHOOK_STALE_LOCK_MINUTES=5
WEBHOOK_MAX_PROCESSING_ATTEMPTS=10

# cPanel persistent local storage option. Keep this directory outside every
# versioned release so deploying or deleting a release never removes uploads.
MEDIA_STORAGE_PROVIDER=local
MEDIA_UPLOAD_MAX_MB=10
LOCAL_MEDIA_ROOT=/home/CPANEL_USER/watplux/shared/media
CPANEL_PERSISTENT_LOCAL_MEDIA=true

# S3 alternative (recommended when the hosting filesystem is not backed up):
# MEDIA_STORAGE_PROVIDER=s3
# CPANEL_PERSISTENT_LOCAL_MEDIA=false
# S3_REGION=auto
# S3_ENDPOINT=https://replace-with-s3-compatible-endpoint
# S3_BUCKET=watplux-production-media
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Used only by the explicit first-deployment seed command. Remove these values
# from the runtime environment after the initial administrator is created.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME="Store owner"
