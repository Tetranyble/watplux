{
  "name": "watplux",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-dev-data.ts",
    "postinstall": "prisma generate",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:browser": "playwright test --project=chromium --project=mobile-chromium",
    "test:release": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:integration && npm run test:e2e",
    "db:migrate:deploy": "prisma migrate deploy",
    "ops:preflight": "node scripts/production-preflight.mjs",
    "ops:backup:mysql": "node scripts/backup-mysql.mjs",
    "audit:release": "node scripts/release-audit.mjs",
    "release:gate": "npm run audit:lockfile && npm run audit:ui && npm run audit:release && npm run test:release && npm run build",
    "audit:ui": "node scripts/ui-system-audit.mjs",
    "audit:lockfile": "node scripts/check-lockfile-sync.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.7.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "shadcn": "^4.16.2",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "better-auth": "^1.7.2",
    "@better-auth/prisma-adapter": "^1.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
