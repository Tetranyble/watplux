enum CouponType {
  FLAT
  PERCENTAGE
}

model Coupon {
  id                    BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  code                  String     @unique @db.VarChar(50)
  type                  CouponType
  valueMinor            Int?       @map("value_minor") @db.UnsignedInt
  percentage            Decimal?   @db.Decimal(5, 2)
  maxDiscountMinor      Int?       @map("max_discount_minor") @db.UnsignedInt
  minOrderAmountMinor   Int?       @map("min_order_amount_minor") @db.UnsignedInt
  usageLimit            Int?       @map("usage_limit") @db.UnsignedInt
  usageLimitPerCustomer Int?       @map("usage_limit_per_customer") @db.UnsignedSmallInt
  startsAt              DateTime?  @map("starts_at")
  expiresAt             DateTime?  @map("expires_at")
  isActive              Boolean    @default(true) @map("is_active")
