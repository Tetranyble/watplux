NODE_ENV=production
DEPLOYMENT_ENV=production
LOG_LEVEL=info
APP_VERSION=0.1.0
GIT_SHA=replace-with-release-sha

# Managed MySQL 8-compatible database. Require provider-side TLS and backups.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/watplux

BETTER_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://shop.example.com
APP_BASE_URL=https://shop.example.com
SESSION_TTL_DAYS=30
TRUSTED_CLIENT_IP_HEADER=x-real-ip

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=notifications@shop.example.com
MAIL_PASSWORD=replace-me
MAIL_FROM_ADDRESS=notifications@shop.example.com
MAIL_FROM_NAME=Watplux

# Optional Termii service-request acknowledgements.
# TERMII_BASE_URL=https://your-region.termii.com
# TERMII_API_KEY=replace-me
# TERMII_SENDER_ID=Watplux
# TERMII_CHANNEL=dnd

PAYSTACK_SECRET_KEY=sk_live_replace_me
GUEST_ORDER_TOKEN_SECRET=replace-with-random-secret-at-least-32-characters
INTERNAL_WORKER_SECRET=replace-with-random-secret-at-least-32-characters
WEBHOOK_STALE_LOCK_MINUTES=5
WEBHOOK_MAX_PROCESSING_ATTEMPTS=10

MEDIA_STORAGE_PROVIDER=s3
MEDIA_UPLOAD_MAX_MB=10
CPANEL_PERSISTENT_LOCAL_MEDIA=false
S3_REGION=auto
S3_ENDPOINT=https://replace-with-s3-compatible-endpoint
S3_BUCKET=watplux-production-media
# Prefer workload/IAM credentials where the provider supports them.
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
# Optional CDN origin; application media URLs remain stable even if this changes.
S3_PUBLIC_BASE_URL=https://cdn.example.com
