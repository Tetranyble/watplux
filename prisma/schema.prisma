  @@map("coupon_redemptions")
}

// ============================================================================
// PAYMENTS DOMAIN — docs/DATABASE_DESIGN.md §8, §9
//
// Closes the approved circular reference: Order.authoritativePaymentAttemptId
// (declared as a plain scalar + unique index in the Commerce migration) gets
// its real relation + FK here, now that PaymentAttempt exists. This is an
// ALTER TABLE ADD CONSTRAINT in this migration, not a redesign — see
// docs/DATABASE_DESIGN.md §13 discussion / Phase 2B report §13.
// ============================================================================

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  INITIALIZATION_FAILED
}

model PaymentAttempt {
  id                BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  orderId           BigInt               @map("order_id") @db.UnsignedBigInt
  paystackReference String               @unique @map("paystack_reference") @db.VarChar(100)
  amountMinor       Int                  @map("amount_minor") @db.UnsignedInt
  currency          String               @default("NGN") @db.Char(3)
  status            PaymentAttemptStatus
  channel           String?              @db.VarChar(30)
  authorizationUrl  String?              @map("authorization_url") @db.VarChar(500)
  accessCode        String?              @map("access_code") @db.VarChar(100)
  gatewayResponse   String?              @map("gateway_response") @db.VarChar(255)
  errorCode         String?              @map("error_code") @db.VarChar(50)
  errorMessage      String?              @map("error_message") @db.VarChar(500)

  // Two-ledger refund allocation model (docs/DATABASE_DESIGN.md §9 — the
  // Phase 2A revision fix): refundedAmountMinor is CONFIRMED refunds only;
  // pendingRefundAmountMinor is IN-FLIGHT (REFUND_REQUESTED/REFUND_PENDING)
  // allocations. Never conflate the two.
  refundedAmountMinor            Int  @default(0) @map("refunded_amount_minor") @db.UnsignedInt
  pendingRefundAmountMinor       Int  @default(0) @map("pending_refund_amount_minor") @db.UnsignedInt
  // Generated column (hand-edited in migration): amountMinor -
  // refundedAmountMinor - pendingRefundAmountMinor. Same derived-column
  // pattern as inventory_items.quantity_available.
  availableRefundableAmountMinor Int? @map("available_refundable_amount_minor") @db.UnsignedInt

  paidAt    DateTime? @map("paid_at")
  failedAt  DateTime? @map("failed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  order                 Order          @relation("OrderPaymentAttempts", fields: [orderId], references: [id], onDelete: Restrict)
  authoritativeForOrder Order?         @relation("OrderAuthoritativePaymentAttempt")
  refunds               Refund[]
  resolvedWebhookEvents WebhookEvent[]

  @@index([orderId, status], map: "idx_payment_attempts_order_status")
  @@index([status, createdAt], map: "idx_payment_attempts_status_created")
  @@map("payment_attempts")
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model WebhookEvent {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  provider              String                  @default("paystack") @db.VarChar(20)
  eventType             String                  @map("event_type") @db.VarChar(50)
  paystackTransactionId String                  @map("paystack_transaction_id") @db.VarChar(50)
  paystackReference     String?                 @map("paystack_reference") @db.VarChar(100)
  rawPayload            Json                    @map("raw_payload")
  processingStatus      WebhookProcessingStatus @default(PENDING) @map("processing_status")
  processingAttempts    Int                     @default(0) @map("processing_attempts") @db.UnsignedSmallInt
  lockedAt              DateTime?               @map("locked_at")
  processedAt           DateTime?               @map("processed_at")
  errorMessage          String?                 @map("error_message") @db.Text

  // Two exclusive nullable FKs instead of a single polymorphic reference —
  // docs/DATABASE_DESIGN.md §8: real referential integrity for a two-way
  // (not open-ended) polymorphism, unlike the rejected `media` design (§14).
  resolvedPaymentAttemptId BigInt? @map("resolved_payment_attempt_id") @db.UnsignedBigInt
  resolvedRefundId         BigInt? @map("resolved_refund_id") @db.UnsignedBigInt

  receivedAt DateTime @default(now()) @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // DEVIATION FROM docs/DATABASE_DESIGN.md §8 (documented, not silent — see
  // Phase 2B report): the design specifies ON DELETE SET NULL here, but
  // MySQL (error 3823) refuses a CHECK constraint on any column that
  // participates in a SET NULL/CASCADE foreign-key referential action —
  // and the mutual-exclusivity CHECK below is an explicit, "MUST be
  // preserved" requirement. RESTRICT instead; since payment_attempts/
  // refunds are immutable historical records that are never deleted in
  // this design (docs/DATABASE_DESIGN.md §20), this changes nothing in
  // practice — there is no delete path for either to ever exercise SET NULL.
  resolvedPaymentAttempt PaymentAttempt? @relation(fields: [resolvedPaymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedRefund         Refund?         @relation(fields: [resolvedRefundId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([eventType, paystackTransactionId], map: "uq_webhook_events_natural_key")
  @@index([processingStatus, lockedAt], map: "idx_webhook_events_claim")
  @@index([paystackReference], map: "idx_webhook_events_reference")
  @@index([processingStatus, receivedAt], map: "idx_webhook_events_status_received")
  @@map("webhook_events")
}

enum RefundStatus {
  REFUND_REQUESTED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
  REFUND_CANCELLED
}

model Refund {
  id                      BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  paymentAttemptId        BigInt       @map("payment_attempt_id") @db.UnsignedBigInt
  orderId                 BigInt       @map("order_id") @db.UnsignedBigInt
  paystackRefundReference String?      @unique @map("paystack_refund_reference") @db.VarChar(100)
  amountMinor             Int          @map("amount_minor") @db.UnsignedInt
  status                  RefundStatus
  reason                  String?      @db.Text
  requestedBy             BigInt       @map("requested_by") @db.UnsignedBigInt
  requestedAt             DateTime     @default(now()) @map("requested_at")
  processedAt             DateTime?    @map("processed_at")
  rawWebhookPayload       Json?        @map("raw_webhook_payload")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  paymentAttempt  PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedByUser User           @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  webhookEvents   WebhookEvent[]

  @@index([status], map: "idx_refunds_status")
  @@map("refunds")
}

// ============================================================================
// SERVICES / REVIEWS DOMAIN — docs/DATABASE_DESIGN.md §11, §12
// (Coupons/coupon_redemptions were migrated with Commerce, per
// docs/DATABASE_DESIGN.md §0's domain grouping — see Phase 2B report.)
// ============================================================================

enum ServiceType {
  CONSULTATION
  SYSTEM_SIZING
  INSTALLATION
  MAINTENANCE
  SITE_ASSESSMENT
}

enum ServiceRequestStatus {
  NEW
  CONTACTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

model ServiceRequest {
  id                          BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  userId                      BigInt?              @map("user_id") @db.UnsignedBigInt
  guestName                   String?              @map("guest_name") @db.VarChar(255)
  guestEmail                  String?              @map("guest_email") @db.VarChar(255)
  guestPhone                  String?              @map("guest_phone") @db.VarChar(32)
  serviceType                 ServiceType          @map("service_type")
  status                      ServiceRequestStatus
  propertyType                PropertyType?        @map("property_type")
  location                    String?              @db.VarChar(500)
  currentElectricitySituation String?              @map("current_electricity_situation") @db.Text
  estimatedMonthlyUsageKwh    Decimal?             @map("estimated_monthly_usage_kwh") @db.Decimal(10, 2)
  appliances                  String?              @db.Text
  desiredBackupHours          Decimal?             @map("desired_backup_hours") @db.Decimal(5, 2)
  existingEquipment           String?              @map("existing_equipment") @db.Text
  budgetRange                 String?              @map("budget_range") @db.VarChar(50)
  preferredAppointmentAt      DateTime?            @map("preferred_appointment_at")
  additionalInfo              String?              @map("additional_info") @db.Text
  assignedTo                  BigInt?              @map("assigned_to") @db.UnsignedBigInt
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")

  requester User? @relation("ServiceRequestRequester", fields: [userId], references: [id], onDelete: SetNull)
  assignee  User? @relation("ServiceRequestAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "idx_service_requests_queue")
  @@index([serviceType], map: "idx_service_requests_type")
  @@index([assignedTo], map: "idx_service_requests_assignee")
  @@index([userId, createdAt, id], map: "idx_service_requests_user_created")
  @@index([assignedTo, status, createdAt], map: "idx_service_requests_assignee_queue")
  @@map("service_requests")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  productId   BigInt       @map("product_id") @db.UnsignedBigInt
  userId      BigInt       @map("user_id") @db.UnsignedBigInt
  orderItemId BigInt?      @map("order_item_id") @db.UnsignedBigInt
  rating      Int          @db.UnsignedTinyInt
  title       String?      @db.VarChar(255)
  body        String       @db.Text
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([productId, userId], map: "uq_reviews_product_user")
  @@index([productId, status], map: "idx_reviews_product_status")
  @@map("reviews")
}

// ============================================================================
// MEDIA DOMAIN — Phase 14
// Generic reusable media library. Business entities keep their existing URL
// fields; media assets own storage metadata and may be reused by products,
// categories and brands without duplicating binary objects.
// ============================================================================

enum MediaStorageProvider {
  LOCAL
  S3
}

model MediaAsset {
  id             String               @id @db.VarChar(36)
  provider       MediaStorageProvider
  originalName   String               @map("original_name") @db.VarChar(255)
  mimeType       String               @map("mime_type") @db.VarChar(120)
  sizeBytes      BigInt               @map("size_bytes") @db.UnsignedBigInt
  storageKey     String               @map("storage_key") @db.VarChar(700)
  publicUrl      String               @map("public_url") @db.VarChar(1000)
  width          Int                  @db.UnsignedSmallInt
  height         Int                  @db.UnsignedSmallInt
  checksumSha256 String               @map("checksum_sha256") @db.Char(64)
  createdById    BigInt?              @map("created_by") @db.UnsignedBigInt
  createdAt      DateTime             @default(now()) @map("created_at")

  createdBy User? @relation("MediaAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([provider, createdAt], map: "idx_media_assets_provider_created")
  @@index([createdById, createdAt], map: "idx_media_assets_creator_created")
  @@index([checksumSha256], map: "idx_media_assets_checksum")
  @@map("media_assets")
}

// ============================================================================
// SECURITY / ABUSE CONTROL — Phase 15
// ============================================================================

// Better Auth's database-backed rate limiter model. Field names intentionally
// match Better Auth's adapter contract; the SQL table remains snake_case.
model RateLimit {
  id          String @id @db.VarChar(64)
  key         String @db.VarChar(191)
  count       Int    @db.UnsignedInt
  lastRequest BigInt @map("last_request")

  @@index([key], map: "idx_rate_limits_key")
  @@map("rate_limits")
}

// Application public-endpoint limiter (service requests, checkout, etc.).
// Kept separate from Better Auth so auth-library persistence semantics do not
// leak into business HTTP middleware.
model RequestRateLimit {
  id              String   @id @db.VarChar(36)
  bucketKey       String   @unique(map: "uq_request_rate_limits_bucket") @map("bucket_key") @db.VarChar(191)
  count           Int      @default(0) @db.UnsignedInt
  windowStartedAt DateTime @map("window_started_at")
  expiresAt       DateTime @map("expires_at")

  @@index([expiresAt], map: "idx_request_rate_limits_expiry")
  @@map("request_rate_limits")
}

// ============================================================================
// ADMINISTRATION DOMAIN — docs/DATABASE_DESIGN.md §15, §16
// ============================================================================

enum AuditLogActorType {
  USER
  SYSTEM
}

model AuditLog {
  id         BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  actorId    BigInt?           @map("actor_id") @db.UnsignedBigInt
  actorType  AuditLogActorType @default(USER) @map("actor_type")
  action     String            @db.VarChar(100)
  // Deliberately not a real FK — the target table varies per row and spans
  // essentially every table in the system (docs/DATABASE_DESIGN.md §15).
  // Audit logs are read for investigation, not joined into transactional
  // queries, so the referential-integrity loss is an accepted tradeoff here.
  entityType String            @map("entity_type") @db.VarChar(50)
  entityId   BigInt            @map("entity_id") @db.UnsignedBigInt
  beforeData Json?             @map("before_data")
  afterData  Json?             @map("after_data")
  ipAddress  String?           @map("ip_address") @db.VarChar(45)
  createdAt  DateTime          @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt], map: "idx_audit_logs_entity")
  @@index([actorId, createdAt], map: "idx_audit_logs_actor")
  @@index([action, createdAt], map: "idx_audit_logs_action")
  @@map("audit_logs")
}

model Settings {
  // Singleton row — always id=1, enforced by application convention (not a
  // database constraint beyond the primary key itself). docs/DATABASE_DESIGN.md §16.
  id                       Int      @id @default(1) @db.UnsignedTinyInt
  siteName                 String?  @map("site_name") @db.VarChar(150)
  defaultCurrency          String   @default("NGN") @map("default_currency") @db.Char(3)
  defaultDeliveryFeeMinor  Int?     @map("default_delivery_fee_minor") @db.UnsignedInt
  lowStockThresholdDefault Decimal? @map("low_stock_threshold_default") @db.Decimal(12, 3)
  supportEmail             String?  @map("support_email") @db.VarChar(255)
  supportPhone             String?  @map("support_phone") @db.VarChar(32)
  updatedBy                BigInt?  @map("updated_by") @db.UnsignedBigInt
  updatedAt                DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("settings")
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model SettingEntry {
  key         String           @id @db.VarChar(100)
  value       Json
  valueType   SettingValueType @map("value_type")
  description String?          @db.VarChar(255)
  updatedBy   BigInt?          @map("updated_by") @db.UnsignedBigInt
  updatedAt   DateTime         @updatedAt @map("updated_at")

  updatedByUser User? @relation("SettingEntriesUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("setting_entries")
}
