# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# MySQL connection string used by Prisma.
# Matches the service defined in docker-compose.yml for local development.
DATABASE_URL="mysql://watplux:watplux@localhost:3306/watplux"

# Next.js runtime mode.
# development | test | production
NODE_ENV="development"

# Deployment identity. Staging should use NODE_ENV=production with
# DEPLOYMENT_ENV=staging; only the live environment uses production here.
# local | test | build | staging | production
DEPLOYMENT_ENV="local"
APP_VERSION="0.1.0"
GIT_SHA="local"

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Authentication — Better Auth owns sign-up, sign-in, credential accounts,
# sessions and verification records. Generate a 32+ character random secret
# for every deployed environment. Better Auth uses the existing Prisma/MySQL
# connection and the app keeps its own roles/permissions for business RBAC.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
SESSION_TTL_DAYS="30"

# Must be overwritten by the trusted ingress/reverse proxy.
TRUSTED_CLIENT_IP_HEADER="x-real-ip"

# Payment (Phase 8) — optional; only required for a real Paystack call or
# to enable the internal webhook-worker trigger route. Never commit a
# real secret key. See docs/PHASE_8_PAYMENT_PAYSTACK_PLAN.md §7/§21.
# PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# INTERNAL_WORKER_SECRET="a-long-random-shared-secret-at-least-32-characters"
WEBHOOK_STALE_LOCK_MINUTES="5"
WEBHOOK_MAX_PROCESSING_ATTEMPTS="10"

# Guest payment-result access token (Phase 9) — optional; a 32+ char
# random secret. If unset, guest checkout customers don't get a live
# payment-status page after Paystack redirects them back (a disclosed,
# accepted limitation — see docs/PHASE_9_STOREFRONT_PLAN.md §13.4).
# GUEST_ORDER_TOKEN_SECRET="a-long-random-secret-at-least-32-characters"

# Storefront (Phase 9) — the absolute public origin Paystack's hosted
# checkout redirects back to. Defaults to localhost for dev/test; set to
# the real deployed origin in production. See
# docs/PHASE_9_STOREFRONT_PLAN.md §13.1/§31.
APP_BASE_URL="http://localhost:3000"

# Transactional email for verification, password resets and service-request
# acknowledgements. Keep MAIL_MAILER=log locally; production must use smtp.
MAIL_MAILER="log"
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_SCHEME="tls"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Watplux"

# Optional Termii SMS acknowledgement for consultation/service requests.
# TERMII_BASE_URL="https://your-region.termii.com"
# TERMII_API_KEY=""
# TERMII_SENDER_ID="Watplux"
# TERMII_CHANNEL="dnd"
# TERMII_DEFAULT_COUNTRY_CODE="234"

# Bootstrap admin account (Phase 10) — optional. Seeding (`npm run
# db:seed`) creates zero user accounts on its own; set both of these
# before seeding to also create (or promote, if the email already exists)
# a super_admin account you can actually log into /admin with. Leave both
# unset to skip this entirely. Password must be 10+ characters with at
# least one lowercase letter, one uppercase letter, and one digit.
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Admin"


# Media storage (Phase 14). Production readiness requires s3.
MEDIA_STORAGE_PROVIDER="local"
MEDIA_UPLOAD_MAX_MB="10"
LOCAL_MEDIA_ROOT=".storage/media"
# Production local storage is opt-in and must use an absolute path outside an
# immutable release directory. S3 remains the default production choice.
CPANEL_PERSISTENT_LOCAL_MEDIA="false"
# For production S3-compatible storage, set MEDIA_STORAGE_PROVIDER="s3" and configure:
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://..."
# S3_BUCKET="watplux-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
# S3_PUBLIC_BASE_URL="https://cdn.example.com"

# Phase 17 production policy:
# - NODE_ENV=production
# - DEPLOYMENT_ENV=production
# - APP_BASE_URL and BETTER_AUTH_URL must be HTTPS
# - PAYSTACK_SECRET_KEY, INTERNAL_WORKER_SECRET and GUEST_ORDER_TOKEN_SECRET required
# - MAIL_MAILER=smtp, MAIL_HOST and MAIL_FROM_ADDRESS required
# - Media uses S3, or explicit persistent local storage with an absolute path
# - managed MySQL must require TLS and automated backups/PITR at the provider layer
